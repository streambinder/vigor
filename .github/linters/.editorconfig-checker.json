{
  "Verbose": false,
  "Debug": false,
  "IgnoreDefaults": false,
  "SpacesAfterTabs": false,
  "NoColor": false,
  "exclude": [
    "testfiles",
    "app/ios/Runner.xcworkspace/.*",
    "app/ios/Runner/.*\\.plist$",
    "app/ios/.*\\.plist$",
    "app/ios/Pods/.*",
    "app/android/.*\\.xml$",
    "app/build/.*",
    "app/.dart_tool/.*",
    "app/lib/generated/.*",
    "knowledge/features/.*"
  ],
  "AllowedContentTypes": [],
  "PassedFiles": [],
  "Disable": {
    "EndOfLine": false,
    "Indentation": false,
    "InsertFinalNewline": false,
    "TrimTrailingWhitespace": false,
    "IndentSize": false,
    "MaxLineLength": false
  }
}
