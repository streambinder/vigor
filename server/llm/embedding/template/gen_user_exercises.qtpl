{% package template %}

{% import "github.com/streambinder/vigor/model" %}

{% func GenUserExercises(profile model.Profile, equipment []string) -%}
{% collapsespace %}

{% if len(profile.Goals()) > 0 %}
    Fitness goals:
    {% for i, goal := range profile.Goals() %}{%s goal.Description %}{% if i < len(profile.Goals())-1 %}, {% endif %}{% endfor %}.
{% endif %}
{% if len(profile.Injuries()) > 0 %}
    Avoid exercises that impact:
    {% for i, injury := range profile.Injuries() %}{%s injury.Description %}{% if i < len(profile.Injuries())-1 %}, {% endif %}{% endfor %}.
{% endif %}
{% if len(profile.Limitations()) > 0 %}
    Limitations:
    {% for i, limitation := range profile.Limitations() %}{%s limitation %}{% if i < len(profile.Limitations())-1 %}, {% endif %}{% endfor %}.
{% endif %}
{% if len(equipment) > 0 %}
    Available equipment:
    {% for i, equipment := range equipment %}{%s equipment %}{% if i < len(equipment)-1 %}, {% endif %}{% endfor %}.
{% endif %}

{% if len(profile.Goals()) == 0 && len(profile.Injuries()) == 0 && len(profile.Limitations()) == 0 %}
    General strength and fitness training exercises.
{% endif %}

{% endcollapsespace -%}
{% endfunc %}
