{% package prompt %}

{% import "github.com/streambinder/vigor/model" %}
{% import exercisedb "github.com/streambinder/vigor/exercisedb/model" %}

{% func GenTraining(profile *model.Profile, exercises []exercisedb.Exercise, duration int) -%}
{% collapsespace %}

Generate a {%d duration %}min training from these exercises:
{% for _, exercise := range exercises %}
    ID: {%s exercise.ID %}
    {% if len(exercise.Muscles) > 0 %}
        (targets: {% for _, muscle := range exercise.Muscles %}{%s muscle %}, {% endfor %}
        {% if len(exercise.SecondaryMuscles) > 0 %}
            secondary: {% for _, muscle := range exercise.SecondaryMuscles %}{%s muscle %}, {% endfor %}
        {% endif %})
    {% endif %}
{% endfor %}

{% endcollapsespace -%}
{% endfunc %}
