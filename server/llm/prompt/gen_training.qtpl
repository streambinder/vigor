{% package prompt %}

{% import "github.com/streambinder/vigor/model" %}

{% func GenTraining(profile *model.Profile, equipments []string, duration int) -%}
{% collapsespace %}

Generate a {%d duration %} minutes long training

{% if len(equipments) > 0 %}
with
    {% for _, equipment := range equipments %}
        {%s equipment %},
    {% endfor %}
equipment available
{% else %}
with no equipment available
{% endif %}

{% endcollapsespace -%}
{% endfunc %}
