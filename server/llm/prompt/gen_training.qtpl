{% package prompt %}

{% import "github.com/streambinder/vigor/model" %}

{% func GenTraining(profile *model.Profile, equipment []string, duration int) -%}
{% collapsespace %}

Generate a {%d duration %} minutes long training

{% if len(equipment) > 0 %}
with
    {% for _, equipment := range equipment %}
        {%s equipment %},
    {% endfor %}
equipment available. Not all equipment need to be used in this training.
{% else %}
with no equipment available.
{% endif %}

{% endcollapsespace -%}
{% endfunc %}
