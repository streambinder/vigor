package view

import (
	"encoding/json"
	"strconv"
)

templ Dashboard(data DashboardData) {
	@Layout("Cockpit") {
		<h1>Cockpit</h1>
		<div class="grid">
			<div class="card">
				<div class="card-label">Users</div>
				<div class="card-value">{ formatNumber(data.UserCount) }</div>
			</div>
			<div class="card">
				<div class="card-label">Trainings Generated</div>
				<div class="card-value">{ formatNumber(data.TrainingCount) }</div>
			</div>
		</div>
		<div class="chart-container">
			<div class="chart-title">LLM Generation Latency (avg ms)</div>
			<div id="latency-chart"></div>
		</div>
		@templ.JSONScript("chart-data", latencyChartData(data.Latencies))
		@latencyChartScript()
	}
}

type chartData struct {
	Labels []string  `json:"labels"`
	Values []float64 `json:"values"`
}

func latencyChartData(data []LatencyDataPoint) chartData {
	labels := make([]string, len(data))
	values := make([]float64, len(data))
	for i, p := range data {
		labels[i] = p.Label
		values[i] = p.Value
	}
	return chartData{Labels: labels, Values: values}
}

templ latencyChartScript() {
	<script>
		(function() {
			var chartData = JSON.parse(document.getElementById('chart-data').textContent);
			var options = {
				series: [{
					name: 'Avg Latency (ms)',
					data: chartData.values
				}],
				chart: {
					type: 'area',
					height: 300,
					background: 'transparent',
					toolbar: { show: false },
					zoom: { enabled: false }
				},
				dataLabels: { enabled: false },
				stroke: { curve: 'smooth', width: 2 },
				fill: {
					type: 'gradient',
					gradient: {
						shadeIntensity: 1,
						opacityFrom: 0.4,
						opacityTo: 0.1
					}
				},
				colors: ['#58a6ff'],
				xaxis: {
					categories: chartData.labels,
					labels: { style: { colors: '#8b949e' } },
					axisBorder: { color: '#30363d' },
					axisTicks: { color: '#30363d' }
				},
				yaxis: {
					labels: { style: { colors: '#8b949e' } }
				},
				grid: {
					borderColor: '#30363d',
					strokeDashArray: 4
				},
				tooltip: {
					theme: 'dark',
					y: { formatter: function(val) { return val + ' ms'; } }
				}
			};
			new ApexCharts(document.querySelector("#latency-chart"), options).render();
		})();
	</script>
}

func formatNumber(n int64) string {
	if n >= 1000000 {
		return strconv.FormatFloat(float64(n)/1000000, 'f', 1, 64) + "M"
	}
	if n >= 1000 {
		return strconv.FormatFloat(float64(n)/1000, 'f', 1, 64) + "K"
	}
	return strconv.FormatInt(n, 10)
}

// silence unused import
var _ = json.Marshal
