package view

import (
	"encoding/json"
	"fmt"
	"strconv"
	"time"

	"github.com/google/uuid"
	"github.com/streambinder/vigor/model"
)

templ Dashboard(data DashboardData) {
	@Layout("Cockpit") {
		<h1>Cockpit</h1>
		<div class="grid">
			<div class="card">
				<div class="card-label">Users</div>
				<div class="card-value">{ formatNumber(data.UserCount) } <span class="card-sub">{ formatFloat(data.AvgActiveUsersPerDay) }<span class="muted">/day</span></span></div>
			</div>
			<div class="card">
				<div class="card-label">Trainings</div>
				<div class="card-value">{ formatNumber(data.TrainingGenerationCount) } <span class="card-sub">{ formatFloat(data.AvgTrainingGenerationsPerDay) }<span class="muted">/day</span></span></div>
			</div>
			<div class="card">
				<div class="card-label">Completed</div>
				<div class="card-value">{ formatNumber(data.CompletedTrainingCount) } <span class="card-sub">{ formatFloat(data.AvgCompletedTrainingsPerDay) }<span class="muted">/day</span></span></div>
			</div>
		</div>
		<div class="chart-container">
			<div class="chart-title">Active Users <span class="muted">(per day)</span></div>
			<div id="active-users-chart"></div>
		</div>
		@templ.JSONScript("active-users-chart-data", multiSeriesChartData(data.ActiveUsersPerDay))
		<div class="chart-container">
			<div class="chart-title">Training Generation Latency <span class="muted">(p95 ms)</span></div>
			<div id="training-latency-chart"></div>
		</div>
		@templ.JSONScript("training-chart-data", multiSeriesChartData(data.TrainingGenerationLatencies))
		<div class="chart-container">
			<div class="chart-title">Training Generation Failures</div>
			<div id="training-failures-chart"></div>
		</div>
		@templ.JSONScript("training-failures-chart-data", multiSeriesChartData(data.TrainingGenerationFailures))
		<div class="chart-container">
			<div class="chart-title">Bad Quality Ratings</div>
			<div id="bad-quality-chart"></div>
		</div>
		@templ.JSONScript("bad-quality-chart-data", multiSeriesChartData(data.BadQualityPerModel))
		<div class="chart-container">
			<div class="chart-title">Handler Request Latency <span class="muted">(p95 ms)</span></div>
			<div id="handler-latency-chart"></div>
		</div>
		@templ.JSONScript("handler-chart-data", multiSeriesChartData(data.HandlerRequestLatencies))
		<div class="chart-container">
			<div class="chart-title">Handler Request Errors <span class="muted">(5xx count)</span></div>
			<div id="handler-errors-chart"></div>
		</div>
		@templ.JSONScript("errors-chart-data", multiSeriesChartData(data.HandlerRequestErrors))
		@latencyChartScript()
		<div class="table-container" id="trainings-container">
			<div class="table-title">Trainings</div>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th>Date</th>
							<th>ID</th>
							<th>User</th>
							<th>Name</th>
							<th>Type</th>
							<th>Duration</th>
							<th>Completed</th>
							<th></th>
						</tr>
					</thead>
					<tbody id="trainings-tbody">
						for i, t := range data.Trainings {
							<tr class="training-row">
								<td>{ t.CreatedAt.Format("Jan 2, 15:04") }</td>
								<td>{ t.ID.String()[:8] }</td>
								<td>{ t.User.Email }</td>
								<td>{ t.Name }</td>
								<td>{ t.Methodology }</td>
								<td>{ formatDuration(t.Duration) }</td>
								<td>{ formatCompleted(t.CompletedAt) }</td>
								<td>
									<button class="btn-json" onclick={ showTrainingJSON(i) }>JSON</button>
								</td>
							</tr>
						}
						if len(data.Trainings) == 0 {
							<tr>
								<td colspan="8" class="empty-row">No trainings</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if len(data.Trainings) > 15 {
				<div class="pagination" id="trainings-pagination"></div>
			}
		</div>
		for i, t := range data.Trainings {
			@templ.JSONScript(fmt.Sprintf("training-%d", i), t)
		}
		<div id="modal" class="modal" onclick="closeModal(event)">
			<div class="modal-content" onclick="event.stopPropagation()">
				<div class="modal-header">
					<span class="modal-title">JSON</span>
					<button class="modal-close" onclick="closeModal()">&times;</button>
				</div>
				<pre id="modal-json"></pre>
			</div>
		</div>
		@modalScript()
		<div class="table-container" id="reports-container">
			<div class="table-title">Reports</div>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th>Date</th>
							<th>ID</th>
							<th>User</th>
							<th>Content</th>
							<th>Training</th>
							<th>Activity</th>
							<th></th>
						</tr>
					</thead>
					<tbody id="reports-tbody">
						for i, r := range data.Reports {
							<tr class="report-row" id={ "report-" + r.ID.String() }>
								<td>{ r.CreatedAt.Format("Jan 2, 15:04") }</td>
								<td>{ r.ID.String()[:8] }</td>
								<td>{ r.User.Email }</td>
								<td class="content-cell">{ r.Content }</td>
								<td>{ uuidPtrToStr(r.TrainingID) }</td>
								<td>{ ptrToStr(r.ActivityID) }</td>
								<td>
									if r.Activity != nil {
										<button class="btn-json" onclick={ showReportJSON(i, "activity") }>JSON</button>
									} else if r.Training != nil {
										<button class="btn-json" onclick={ showReportJSON(i, "training") }>JSON</button>
									}
									<button class="btn-delete" onclick={ deleteReport(r.ID.String()) }>Delete</button>
								</td>
							</tr>
						}
						if len(data.Reports) == 0 {
							<tr>
								<td colspan="7" class="empty-row">No reports</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if len(data.Reports) > 15 {
				<div class="pagination" id="reports-pagination"></div>
			}
		</div>
		for i, r := range data.Reports {
			if r.Activity != nil {
				@templ.JSONScript(fmt.Sprintf("report-%d-activity", i), r.Activity)
			} else if r.Training != nil {
				@templ.JSONScript(fmt.Sprintf("report-%d-training", i), r.Training)
			}
		}
		<div class="table-container" id="users-container">
			<div class="table-title">Users</div>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th>Date</th>
							<th>ID</th>
							<th>Email</th>
							<th>Name</th>
						</tr>
					</thead>
					<tbody id="users-tbody">
						for _, u := range data.Users {
							<tr class="user-row">
								<td>{ u.CreatedAt.Format("Jan 2, 15:04") }</td>
								<td>{ u.ID.String()[:8] }</td>
								<td>{ u.Email }</td>
								<td>{ u.Profile.FirstName } { u.Profile.LastName }</td>
							</tr>
						}
						if len(data.Users) == 0 {
							<tr>
								<td colspan="4" class="empty-row">No users</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			if len(data.Users) > 15 {
				<div class="pagination" id="users-pagination"></div>
			}
		</div>
		@paginationScript()
	}
}

type multiSeriesData struct {
	Labels []string         `json:"labels"`
	Series []seriesChartData `json:"series"`
}

type seriesChartData struct {
	Name string    `json:"name"`
	Data []float64 `json:"data"`
}

func multiSeriesChartData(series []LatencySeries) multiSeriesData {
	// collect all unique labels in order
	labelSet := make(map[string]bool)
	var labels []string
	for _, s := range series {
		for _, p := range s.Points {
			if !labelSet[p.Label] {
				labelSet[p.Label] = true
				labels = append(labels, p.Label)
			}
		}
	}

	// build series data aligned with labels
	var chartSeries []seriesChartData
	for _, s := range series {
		pointMap := make(map[string]float64)
		for _, p := range s.Points {
			pointMap[p.Label] = p.Value
		}
		var data []float64
		for _, l := range labels {
			data = append(data, pointMap[l])
		}
		chartSeries = append(chartSeries, seriesChartData{
			Name: s.Name,
			Data: data,
		})
	}

	return multiSeriesData{Labels: labels, Series: chartSeries}
}

templ latencyChartScript() {
	<script>
		(function() {
			function renderChart(dataId, chartId, suffix) {
				var chartData = JSON.parse(document.getElementById(dataId).textContent);
				if (!chartData.series || chartData.series.length === 0) return;
				var series = chartData.series.map(function(s) {
					return { name: s.name, data: s.data };
				});
				var options = {
					series: series,
					chart: {
						type: 'area',
						height: 300,
						background: 'transparent',
						toolbar: { show: false },
						zoom: { enabled: false },
						animations: { enabled: false }
					},
					dataLabels: { enabled: false },
					stroke: { curve: 'smooth', width: 2 },
					fill: {
						type: 'gradient',
						gradient: {
							shadeIntensity: 1,
							opacityFrom: 0.4,
							opacityTo: 0.1
						}
					},
					xaxis: {
						categories: chartData.labels,
						labels: { style: { colors: '#8b949e' } },
						axisBorder: { color: '#30363d' },
						axisTicks: { color: '#30363d' }
					},
					yaxis: function() {
						var cfg = {
							min: 0,
							labels: {
								style: { colors: '#8b949e' },
								formatter: function(val) { return suffix ? val.toFixed(1) : Math.round(val); }
							}
						};
						if (!suffix) {
							var max = 0;
							series.forEach(function(s) { s.data.forEach(function(v) { if (v > max) max = v; }); });
							max = Math.max(max, 10);
							cfg.tickAmount = max;
							cfg.max = max;
						}
						return cfg;
					}(),
					grid: {
						borderColor: '#30363d',
						strokeDashArray: 4
					},
					tooltip: {
						theme: 'dark',
						y: { formatter: function(val) { return val != null ? (suffix ? val.toFixed(1) + suffix : Math.round(val)) : undefined; } }
					},
					legend: {
						labels: { colors: '#8b949e' }
					}
				};
				new ApexCharts(document.querySelector(chartId), options).render();
			}
			function renderBarChart(dataId, chartId) {
				var chartData = JSON.parse(document.getElementById(dataId).textContent);
				if (!chartData.series || chartData.series.length === 0) return;
				var options = {
					series: [{ name: chartData.series[0].name, data: chartData.series[0].data }],
					chart: {
						type: 'bar',
						height: 300,
						background: 'transparent',
						toolbar: { show: false },
						animations: { enabled: false }
					},
					plotOptions: { bar: { borderRadius: 4, horizontal: true } },
					dataLabels: { enabled: true, style: { colors: ['#c9d1d9'] } },
					xaxis: function() {
						var max = 0;
						chartData.series[0].data.forEach(function(v) { if (v > max) max = v; });
						max = Math.max(max, 10);
						return {
							categories: chartData.labels,
							labels: {
								style: { colors: '#8b949e' },
								formatter: function(val) { return Math.round(val); }
							},
							axisBorder: { color: '#30363d' },
							axisTicks: { color: '#30363d' },
							tickAmount: max,
							max: max,
							min: 0
						};
					}(),
					yaxis: { labels: { style: { colors: '#8b949e' } } },
					grid: { borderColor: '#30363d', strokeDashArray: 4 },
					tooltip: {
						theme: 'dark',
						y: { formatter: function(val) { return Math.round(val); } }
					}
				};
				new ApexCharts(document.querySelector(chartId), options).render();
			}
			renderChart('active-users-chart-data', '#active-users-chart', '');
			renderChart('training-chart-data', '#training-latency-chart', ' ms');
			renderChart('handler-chart-data', '#handler-latency-chart', ' ms');
			renderChart('training-failures-chart-data', '#training-failures-chart', '');
			renderChart('errors-chart-data', '#handler-errors-chart', '');
			renderBarChart('bad-quality-chart-data', '#bad-quality-chart');
		})();
	</script>
}

func formatNumber(n int64) string {
	if n >= 1000000 {
		return strconv.FormatFloat(float64(n)/1000000, 'f', 1, 64) + "M"
	}
	if n >= 1000 {
		return strconv.FormatFloat(float64(n)/1000, 'f', 1, 64) + "K"
	}
	return strconv.FormatInt(n, 10)
}

func formatFloat(f float64) string {
	return fmt.Sprintf("%.1f", f)
}

func ptrToStr(s *string) string {
	if s == nil {
		return "-"
	}
	if len(*s) > 8 {
		return (*s)[:8]
	}
	return *s
}

func uuidPtrToStr(u *uuid.UUID) string {
	if u == nil {
		return "-"
	}
	return u.String()[:8]
}

func formatDuration(seconds int) string {
	return fmt.Sprintf("%dm", seconds/60)
}

func formatCompleted(t *time.Time) string {
	if t == nil {
		return "-"
	}
	return t.Format("Jan 2, 15:04")
}

script showTrainingJSON(index int) {
	var el = document.getElementById('training-' + index);
	var data = JSON.parse(el.textContent);
	document.getElementById('modal-json').textContent = JSON.stringify(data, null, 2);
	document.getElementById('modal').classList.add('open');
}

script showReportJSON(index int, kind string) {
	var el = document.getElementById('report-' + index + '-' + kind);
	var data = JSON.parse(el.textContent);
	document.getElementById('modal-json').textContent = JSON.stringify(data, null, 2);
	document.getElementById('modal').classList.add('open');
}

script deleteReport(id string) {
	if (!confirm('Delete this report?')) return;
	fetch('/report/' + id, { method: 'DELETE' }).then(function(res) {
		if (res.ok) document.getElementById('report-' + id).remove();
	});
}

templ modalScript() {
	<script>
		function closeModal(event) {
			if (event && event.target !== document.getElementById('modal')) return;
			document.getElementById('modal').classList.remove('open');
		}
		document.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') closeModal();
		});
	</script>
}

templ paginationScript() {
	<script>
		(function() {
			var pageSize = 15;
			function setupPagination(tbodyId, rowClass, paginationId) {
				var tbody = document.getElementById(tbodyId);
				var pagination = document.getElementById(paginationId);
				if (!tbody || !pagination) return;
				var rows = tbody.querySelectorAll('.' + rowClass);
				if (rows.length <= pageSize) return;
				var totalPages = Math.ceil(rows.length / pageSize);
				var currentPage = 1;
				function render() {
					rows.forEach(function(row, i) {
						var page = Math.floor(i / pageSize) + 1;
						row.style.display = page === currentPage ? '' : 'none';
					});
					pagination.innerHTML = '';
					var prev = document.createElement('button');
					prev.textContent = '←';
					prev.disabled = currentPage === 1;
					prev.onclick = function() { if (currentPage > 1) { currentPage--; render(); } };
					pagination.appendChild(prev);
					var info = document.createElement('span');
					info.className = 'page-info';
					info.textContent = currentPage + ' / ' + totalPages;
					pagination.appendChild(info);
					var next = document.createElement('button');
					next.textContent = '→';
					next.disabled = currentPage === totalPages;
					next.onclick = function() { if (currentPage < totalPages) { currentPage++; render(); } };
					pagination.appendChild(next);
				}
				render();
			}
			setupPagination('trainings-tbody', 'training-row', 'trainings-pagination');
			setupPagination('reports-tbody', 'report-row', 'reports-pagination');
			setupPagination('users-tbody', 'user-row', 'users-pagination');
		})();
	</script>
}

// silence unused imports
var (
	_ = json.Marshal
	_ model.Training
)
