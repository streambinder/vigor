package view

import (
	"encoding/json"
	"fmt"
	"strconv"
	"time"

	"github.com/google/uuid"
	"github.com/streambinder/vigor/model"
)

templ Dashboard(data DashboardData) {
	@Layout("Vigor Cockpit") {
		<h1>Vigor Cockpit</h1>
		<div class="grid">
			<div class="card">
				<div class="card-label">Users</div>
				<div class="card-value">{ formatNumber(data.UserCount) }</div>
			</div>
			<div class="card">
				<div class="card-label">Trainings Generated</div>
				<div class="card-value">{ formatNumber(data.TrainingCount) }</div>
			</div>
			<div class="card">
				<div class="card-label">Avg Trainings / Day</div>
				<div class="card-value">{ formatFloat(data.AvgTrainingsPerDay) }</div>
			</div>
		</div>
		<div class="chart-container">
			<div class="chart-title">LLM Generation Latency (avg ms)</div>
			<div id="latency-chart"></div>
		</div>
		@templ.JSONScript("chart-data", latencyChartData(data.Latencies))
		@latencyChartScript()
		<div class="table-container" id="trainings-container">
			<div class="table-title">Trainings</div>
			<table>
				<thead>
					<tr>
						<th>Date</th>
						<th>ID</th>
						<th>User</th>
						<th>Name</th>
						<th>Type</th>
						<th>Duration</th>
						<th>Completed</th>
						<th></th>
					</tr>
				</thead>
				<tbody id="trainings-tbody">
					for i, t := range data.Trainings {
						<tr class="training-row">
							<td>{ t.CreatedAt.Format("Jan 2, 15:04") }</td>
							<td>{ t.ID.String()[:8] }</td>
							<td>{ t.User.Email }</td>
							<td>{ t.Name }</td>
							<td>{ t.Type }</td>
							<td>{ formatDuration(t.Duration) }</td>
							<td>{ formatCompleted(t.CompletedAt) }</td>
							<td>
								<button class="btn-json" onclick={ showTrainingJSON(i) }>JSON</button>
							</td>
						</tr>
					}
					if len(data.Trainings) == 0 {
						<tr>
							<td colspan="8" class="empty-row">No trainings</td>
						</tr>
					}
				</tbody>
			</table>
			if len(data.Trainings) > 15 {
				<div class="pagination" id="trainings-pagination"></div>
			}
		</div>
		for i, t := range data.Trainings {
			@templ.JSONScript(fmt.Sprintf("training-%d", i), t)
		}
		<div id="modal" class="modal" onclick="closeModal(event)">
			<div class="modal-content" onclick="event.stopPropagation()">
				<div class="modal-header">
					<span class="modal-title">Training JSON</span>
					<button class="modal-close" onclick="closeModal()">&times;</button>
				</div>
				<pre id="modal-json"></pre>
			</div>
		</div>
		@modalScript()
		<div class="table-container" id="reports-container">
			<div class="table-title">Reports</div>
			<table>
				<thead>
					<tr>
						<th>Date</th>
						<th>ID</th>
						<th>User</th>
						<th>Content</th>
						<th>Training</th>
						<th>Activity</th>
					</tr>
				</thead>
				<tbody id="reports-tbody">
					for _, r := range data.Reports {
						<tr class="report-row">
							<td>{ r.CreatedAt.Format("Jan 2, 15:04") }</td>
							<td>{ r.ID.String()[:8] }</td>
							<td>{ r.User.Email }</td>
							<td class="content-cell">{ r.Content }</td>
							<td>{ uuidPtrToStr(r.TrainingID) }</td>
							<td>{ ptrToStr(r.ActivityID) }</td>
						</tr>
					}
					if len(data.Reports) == 0 {
						<tr>
							<td colspan="6" class="empty-row">No reports</td>
						</tr>
					}
				</tbody>
			</table>
			if len(data.Reports) > 15 {
				<div class="pagination" id="reports-pagination"></div>
			}
		</div>
		@paginationScript()
	}
}

type chartData struct {
	Labels []string  `json:"labels"`
	Values []float64 `json:"values"`
}

func latencyChartData(data []LatencyDataPoint) chartData {
	labels := make([]string, len(data))
	values := make([]float64, len(data))
	for i, p := range data {
		labels[i] = p.Label
		values[i] = p.Value
	}
	return chartData{Labels: labels, Values: values}
}

templ latencyChartScript() {
	<script>
		(function() {
			var chartData = JSON.parse(document.getElementById('chart-data').textContent);
			var options = {
				series: [{
					name: 'Avg Latency (ms)',
					data: chartData.values
				}],
				chart: {
					type: 'area',
					height: 300,
					background: 'transparent',
					toolbar: { show: false },
					zoom: { enabled: false }
				},
				dataLabels: { enabled: false },
				stroke: { curve: 'smooth', width: 2 },
				fill: {
					type: 'gradient',
					gradient: {
						shadeIntensity: 1,
						opacityFrom: 0.4,
						opacityTo: 0.1
					}
				},
				colors: ['#58a6ff'],
				xaxis: {
					categories: chartData.labels,
					labels: { style: { colors: '#8b949e' } },
					axisBorder: { color: '#30363d' },
					axisTicks: { color: '#30363d' }
				},
				yaxis: {
					labels: { style: { colors: '#8b949e' } }
				},
				grid: {
					borderColor: '#30363d',
					strokeDashArray: 4
				},
				tooltip: {
					theme: 'dark',
					y: { formatter: function(val) { return val + ' ms'; } }
				}
			};
			new ApexCharts(document.querySelector("#latency-chart"), options).render();
		})();
	</script>
}

func formatNumber(n int64) string {
	if n >= 1000000 {
		return strconv.FormatFloat(float64(n)/1000000, 'f', 1, 64) + "M"
	}
	if n >= 1000 {
		return strconv.FormatFloat(float64(n)/1000, 'f', 1, 64) + "K"
	}
	return strconv.FormatInt(n, 10)
}

func formatFloat(f float64) string {
	return fmt.Sprintf("%.1f", f)
}

func ptrToStr(s *string) string {
	if s == nil {
		return "-"
	}
	if len(*s) > 8 {
		return (*s)[:8]
	}
	return *s
}

func uuidPtrToStr(u *uuid.UUID) string {
	if u == nil {
		return "-"
	}
	return u.String()[:8]
}

func formatDuration(seconds int) string {
	return fmt.Sprintf("%dm", seconds/60)
}

func formatCompleted(t *time.Time) string {
	if t == nil {
		return "-"
	}
	return t.Format("Jan 2, 15:04")
}

script showTrainingJSON(index int) {
	var el = document.getElementById('training-' + index);
	var data = JSON.parse(el.textContent);
	document.getElementById('modal-json').textContent = JSON.stringify(data, null, 2);
	document.getElementById('modal').classList.add('open');
}

templ modalScript() {
	<script>
		function closeModal(event) {
			if (event && event.target !== document.getElementById('modal')) return;
			document.getElementById('modal').classList.remove('open');
		}
		document.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') closeModal();
		});
	</script>
}

templ paginationScript() {
	<script>
		(function() {
			var pageSize = 15;
			function setupPagination(tbodyId, rowClass, paginationId) {
				var tbody = document.getElementById(tbodyId);
				var pagination = document.getElementById(paginationId);
				if (!tbody || !pagination) return;
				var rows = tbody.querySelectorAll('.' + rowClass);
				if (rows.length <= pageSize) return;
				var totalPages = Math.ceil(rows.length / pageSize);
				var currentPage = 1;
				function render() {
					rows.forEach(function(row, i) {
						var page = Math.floor(i / pageSize) + 1;
						row.style.display = page === currentPage ? '' : 'none';
					});
					pagination.innerHTML = '';
					var prev = document.createElement('button');
					prev.textContent = '←';
					prev.disabled = currentPage === 1;
					prev.onclick = function() { if (currentPage > 1) { currentPage--; render(); } };
					pagination.appendChild(prev);
					var info = document.createElement('span');
					info.className = 'page-info';
					info.textContent = currentPage + ' / ' + totalPages;
					pagination.appendChild(info);
					var next = document.createElement('button');
					next.textContent = '→';
					next.disabled = currentPage === totalPages;
					next.onclick = function() { if (currentPage < totalPages) { currentPage++; render(); } };
					pagination.appendChild(next);
				}
				render();
			}
			setupPagination('trainings-tbody', 'training-row', 'trainings-pagination');
			setupPagination('reports-tbody', 'report-row', 'reports-pagination');
		})();
	</script>
}

// silence unused imports
var (
	_ = json.Marshal
	_ model.Training
)
