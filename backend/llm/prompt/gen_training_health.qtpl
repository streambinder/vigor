{% package prompt %}

{% import "github.com/streambinder/vigor/model" %}

{% func NodeHealthUser(healthSnapshot *model.HealthSnapshot) -%}
{% if healthSnapshot == nil || !healthSnapshot.HasRecoverySignal() %}No recovery metrics available.
{% else %}
{% if healthSnapshot.SleepPresent %}Sleep last night: {%f.1 healthSnapshot.SleepHours %}h (30-day baseline: {%f.1 healthSnapshot.SleepBaseline %}h, deviation: {%s formatDeviation(healthSnapshot.SleepDeviation) %})
{% endif %}
{% if healthSnapshot.HRVPresent %}HRV: {%f.0 healthSnapshot.HRVRMSSD %}ms RMSSD today; 7-day average {%f.0 healthSnapshot.HRVRecentAvg %}ms{% if healthSnapshot.HRVHasZScore %} vs 28-day reference {%f.0 healthSnapshot.HRVBaseline %}ms ({%s formatSD(healthSnapshot.HRVZScore) %} SD){% else %} (reference: {%f.0 healthSnapshot.HRVBaseline %}ms, deviation: {%s formatDeviation(healthSnapshot.HRVDeviation) %}){% endif %}
{% endif %}
{% if healthSnapshot.RHRPresent %}Resting HR: {%d healthSnapshot.RestingHR %}bpm (baseline: {%f.0 healthSnapshot.RHRBaseline %}bpm, 3-day average deviation: {%s formatSD(healthSnapshot.RHRDeviationBpm) %} bpm)
{% endif %}
{% if len(healthSnapshot.ExternalWorkouts) > 0 %}External workouts (last 7 days):
{% for _, w := range healthSnapshot.ExternalWorkouts %}  - {%d w.DaysAgo %} day{% if w.DaysAgo != 1 %}s{% endif %} ago: {%s w.ExerciseType %}, {%d w.DurationMins %}min
{% endfor %}{% endif %}
Sleep baseline from {%d healthSnapshot.BaselineDays %} days (30-day window); recovery reference from {%d healthSnapshot.RecoveryDays %} days (60-day window).
{% endif %}
{% endfunc %}
