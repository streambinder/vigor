{% package prompt %}

{% import "strings" %}
{% import "github.com/streambinder/vigor/model" %}

{% func GenTraining(profile model.Profile, exercises []model.Exercise, prompt string, duration int, recentTrainings []model.Training, facts []model.Fact) -%}
{% collapsespace %}

Generate {%d duration %}min training from these exercises:
{% for _, exercise := range exercises %}
    {%s exercise.ID %} (
    {% if len(exercise.Instructions) > 0 %}Instructions: {%s strings.Join(exercise.Instructions, ", ") %}{% endif %}.
    {% if len(exercise.Muscles) > 0 %}Target muscles: {%s strings.Join(exercise.Muscles, ", ") %}{% endif %}.
    {% if len(exercise.SecondaryMuscles) > 0 %}Secondary muscles: {%s strings.Join(exercise.SecondaryMuscles, ", ") %}{% endif %}.
    {% if len(exercise.BodyParts) > 0 %}Body parts: {%s strings.Join(exercise.BodyParts, ", ") %}{% endif %}.
    {% if len(exercise.Equipment) > 0 %}Equipment: {%s strings.Join(exercise.Equipment, ", ") %}{% endif %}.
    );
{% endfor %}

{% if len(prompt) > 0 %}
Critical constraints by the user:
    {%s prompt %}
{% endif %}

{% if len(recentTrainings) > 0 %}
Recent training history (consider variety and progression):
    {% for _, training := range recentTrainings %}
        {%s training.Type %} workout {%s training.Name %} ({%d training.DaysSince() %} days ago):
        {%s training.Description %}
        (exercises:
        {% for _, routine := range training.Routines %}
            {% for _, block := range routine.Blocks %}
                {% for _, activity := range block.Activities %}
                    {% if activity.Type == "exercise" %}
                        {%s activity.Name %}
                        {% if activity.WeightKg > 0 %}
                            at {%d activity.WeightKg %}kg
                        {% endif %}
                        {% if activity.Reps > 0 %}
                            for {%d activity.WeightKg %} reps
                        {% endif %}
                        {% if activity.Duration > 0 %}
                            for {%d activity.Duration %}s
                        {% endif %}
                        {% if len(activity.Feedback) > 0 %}
                            with feedback "{%s activity.Feedback %}"
                        {% endif %}
                        ;
                    {% endif %}
                {% endfor %}
            {% endfor %}
        {% endfor %}
        );
    {% endfor %}.
{% endif %}

{% if len(facts) > 0 %}
Relevant knowledge facts:
    {% for _, fact := range facts %}
        - {%s fact.Reference %}: {%s fact.Content %}
    {% endfor %}.
{% endif %}

{% endcollapsespace -%}
{% endfunc %}
