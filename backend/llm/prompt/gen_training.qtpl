{% package prompt %}

{% import "encoding/json" %}
{% import "fmt" %}
{% import "strings" %}
{% import "github.com/google/uuid" %}
{% import "github.com/streambinder/vigor/model" %}

{% func GenTraining(
    profiles []model.Profile,
    goals []string,
    workExercises []model.Exercise,
    warmupExercises []model.Exercise,
    cooldownExercises []model.Exercise,
    equipment []string,
    modifiers []model.Modifier,
    modifierVariants map[string][]float64,
    favoriteExercises []model.Exercise,
    favoriteEquipment []string,
    methodology *model.Methodology,
    userPrompt string,
    duration int,
    recentTrainings []model.Training,
    recentFeedback map[uuid.UUID]model.TrainingFeedback,
    facts []model.Fact,
    skipWarmupCooldown bool,
    calibrationGaps map[string]int,
    healthSnapshot *model.HealthSnapshot,
    recentHR map[uuid.UUID]*model.HealthExerciseSession,
    reminders []string,
) -%}
Generate a {%d duration %}-minute training.
{% if skipWarmupCooldown %}
Work routine ONLY. No warmup/cooldown.
{% endif %}

{% if len(userPrompt) > 0 %}
[USER REQUEST]
{%s userPrompt %}

{% endif %}
{% if len(recentTrainings) > 0 %}
[HISTORY — reference only: exercise IDs listed here are NOT available for selection; use ONLY IDs from [WORK]/[WARMUP]/[COOLDOWN]]
{% for _, training := range recentTrainings %}
{% code fb, hasFb := recentFeedback[training.ID] %}
{% code var afb map[string]string; if hasFb { json.Unmarshal(fb.ActivityFeedback, &afb) } %}
{% code actWeights := activityWeights(training) %}
- "{%s training.Name %}" | {%d training.DaysSince() %}d ago | {%s training.Methodology %}{% if training.CompletedIn != nil %} | {%d *training.CompletedIn / 60 %}min actual{% endif %}{% if hasFb && fb.Quality != nil %}{% if *fb.Quality %} | Quality: good{% else %} | Quality: bad{% if fb.QualityReason != "" %} ({%s fb.QualityReason %}){% endif %}{% endif %}{% endif %}{% if hasFb && fb.Message != "" %} | Feedback: "{%s fb.Message %}"{% endif %}{% code hr := recentHR[training.ID] %}{% if hr != nil && hr.AvgHR != nil %} | HR: avg {%d *hr.AvgHR %}{% if hr.MaxHR != nil %}, max {%d *hr.MaxHR %}{% endif %}bpm{% endif %}
{% code seen := make(map[string]bool) %}{% for exID, act := range actWeights %}{% code seen[exID] = true %}  {%s exID %}: {%s formatWeight(act.WeightKg) %}×{%d act.Reps %}{% if fb := afb[exID]; len(fb) > 0 %} ({%s fb %}){% endif %}
{% endfor %}{% for exID, exFb := range afb %}{% if !seen[exID] && len(exFb) > 0 %}  {%s exID %}: {%s exFb %}
{% endif %}{% endfor %}
{% endfor %}
{% endif %}
{% if len(calibrationGaps) > 0 %}
[CALIBRATION — OVERRIDES GOALS]
The platform is calibrating this user's fitness level. Until calibration is complete, FAMILY COVERAGE IS THE TOP PRIORITY — override goal-driven exercise selection.
You MUST select exercises covering as many of these under-sampled movement families as possible:
{% for family, count := range calibrationGaps %}- {%s family %} ({%s fmt.Sprintf("%d/5", count) %})
{% endfor %}Choose a methodology that maximizes coverage of the listed families. Goals are secondary during calibration: use them only to break ties between exercises in the same family.

{% endif %}
{% if len(goals) > 0 %}
[GOALS]
{% for _, goal := range goals %}{%s goal %}, {% endfor %}

{% endif %}
{% if len(profiles) > 1 %}
[PARTNER TRAINING]
{%d len(profiles) %} participants. Use MOST RESTRICTIVE constraints.

{% endif %}
{% for i, profile := range profiles %}
[PROFILE{% if len(profiles) > 1 %} {%d i+1 %}{% endif %}]
Age:{%d profile.Age() %} Height:{%f.0 profile.Height %}cm Weight:{%f.0 profile.Weight %}kg Gender:{%s profile.Gender %}
{% if len(profile.Injuries()) > 0 %}Injuries: {% for j, injury := range profile.Injuries() %}{%s injury.Description %}({%d injury.Year %}){% if j < len(profile.Injuries())-1 %}, {% endif %}{% endfor %}
{% endif %}{% if len(profile.Limitations()) > 0 %}Limitations: {% for j, limitation := range profile.Limitations() %}{%s limitation %}{% if j < len(profile.Limitations())-1 %}, {% endif %}{% endfor %}
{% endif %}{% if len(profile.Conditions()) > 0 %}Conditions: {% for j, condition := range profile.Conditions() %}{%s condition %}{% if j < len(profile.Conditions())-1 %}, {% endif %}{% endfor %}
{% endif %}
{% endfor %}

{% if healthSnapshot != nil %}
[HEALTH SNAPSHOT]
Sleep: {%f.1 healthSnapshot.SleepHours %}h (baseline: {%f.1 healthSnapshot.SleepBaseline %}h, deviation: {%s formatDeviation(healthSnapshot.SleepDeviation) %})
  Deep: {%f.1 healthSnapshot.SleepDeepHours %}h, Light: {%f.1 healthSnapshot.SleepLightHours %}h, REM: {%f.1 healthSnapshot.SleepREMHours %}h
HRV: {%f.0 healthSnapshot.HRVRMSSD %}ms RMSSD (baseline: {%f.0 healthSnapshot.HRVBaseline %}ms, deviation: {%s formatDeviation(healthSnapshot.HRVDeviation) %})
RHR: {%d healthSnapshot.RestingHR %}bpm (baseline: {%f.0 healthSnapshot.RHRBaseline %}bpm, deviation: {%s formatDeviation(healthSnapshot.RHRDeviation) %})
Steps yesterday: {%s formatNumber(healthSnapshot.Steps) %} (baseline: {%s formatNumber(int(healthSnapshot.StepsBaseline)) %}, deviation: {%s formatDeviation(healthSnapshot.StepsDeviation) %})
{% if len(healthSnapshot.ExternalWorkouts) > 0 %}External workouts (last 3 days):
{% for _, w := range healthSnapshot.ExternalWorkouts %}  - {%d w.DaysAgo %} day{% if w.DaysAgo != 1 %}s{% endif %} ago: {%s w.ExerciseType %}, {%d w.DurationMins %}min
{% endfor %}{% endif %}
{% if healthSnapshot.BaselineDays >= 7 %}NOTE: baselines computed from {%d healthSnapshot.BaselineDays %}-day rolling averages.
{% else %}NOTE: baselines not yet established ({%d healthSnapshot.BaselineDays %}/7 days) — extreme-value rules only.
{% endif %}
{% endif %}
{% if len(equipment) > 0 %}
[EQUIPMENT]
{% for i, eq := range equipment %}{%s eq %}{% if i < len(equipment)-1 %}, {% endif %}{% endfor %}

{% endif %}
{% if len(modifiers) > 0 %}
[MODIFIERS]
{% for _, mod := range modifiers %}{%s mod.ID %}: [{%s strings.Join(mod.Patterns, ",") %}]{% if len(mod.Antipatterns) > 0 %} (exclude: [{%s strings.Join(mod.Antipatterns, ",") %}]){% endif %}{% code variants := modifierVariants[mod.ID] %}{% if len(variants) > 0 %} (available: {% for i, w := range variants %}{%s formatWeight(w) %}{% if i < len(variants)-1 %}, {% endif %}{% endfor %}){% endif %}
{% endfor %}
{% endif %}
{% if len(favoriteExercises) > 0 || len(favoriteEquipment) > 0 %}
[FAVORITES]
{% if len(favoriteExercises) > 0 %}Exercises: {% for i, ex := range favoriteExercises %}{%s ex.ID %}{% if i < len(favoriteExercises)-1 %}, {% endif %}{% endfor %}
{% endif %}{% if len(favoriteEquipment) > 0 %}Equipment: {% for i, eq := range favoriteEquipment %}{%s eq %}{% if i < len(favoriteEquipment)-1 %}, {% endif %}{% endfor %}
{% endif %}
{% endif %}

{% if !skipWarmupCooldown %}
[WARMUP] {%d len(warmupExercises) %} options
{% for _, exercise := range warmupExercises %}{%s exercise.ID %}, {% endfor %}

{% endif %}
[WORK] {%d len(workExercises) %} options
{% for _, exercise := range workExercises %}{%s exercise.ID %}{% if len(exercise.Muscles) > 0 %}[{%s exercise.Muscles[0] %}]{% endif %}{% if hasLoadableEquipment(exercise) %}[W]{% endif %}, {% endfor %}

{% if !skipWarmupCooldown %}
[COOLDOWN] {%d len(cooldownExercises) %} options
{% for _, exercise := range cooldownExercises %}{%s exercise.ID %}{% if len(exercise.Muscles) > 0 %}[{%s exercise.Muscles[0] %}]{% endif %}, {% endfor %}

{% endif %}
{% if len(facts) > 0 %}
[FACTS]
Apply when relevant to selected exercises:
{% for i, fact := range facts %}- [F{%d i %}] {%s fact.Content %}
{% endfor %}
{% endif %}
Output language: {% if len(profiles) > 0 && len(profiles[0].Language) > 0 %}{%s profiles[0].Language %}{% else %}English{% endif %}
{%comment%}
  reminders block: critical signals echoed at the end of the prompt to exploit
  recency bias — LLMs attend strongest at beginning/end, weakest in the middle.
  see: https://arxiv.org/html/2511.12869v1
{%endcomment%}
{% if len(reminders) > 0 %}
[REMINDERS]
{% for _, r := range reminders %}- {%s r %}
{% endfor %}{% endif %}
{% endfunc %}
