{% package prompt %}

{% import "strings" %}
{% import "github.com/streambinder/vigor/model" %}

{% func GenTraining(
    profiles []model.Profile,
    workExercises []model.Exercise,
    warmupExercises []model.Exercise,
    cooldownExercises []model.Exercise,
    equipment []string,
    modifiers []model.Modifier,
    userPrompt string,
    duration int,
    recentTrainings []model.Training,
    recentGenerations []model.Training,
    facts []model.Fact,
    classics []model.Classic,
) -%}
Generate a {%d duration %}-minute training session.

{% if len(profiles) > 0 %}{% code var allGoals []string; goalMap := make(map[string]bool) %}{% for _, profile := range profiles %}{% for _, goal := range profile.Goals() %}{% if !goalMap[goal.Description] %}{% code goalMap[goal.Description] = true; allGoals = append(allGoals, goal.Description) %}{% endif %}{% endfor %}{% endfor %}{% if len(allGoals) > 0 %}
<<<USER_GOALS (PRIMARY DESIGN CRITERIA - ALL EXERCISE SELECTIONS MUST SERVE THESE GOALS)>>>
{% for _, goal := range allGoals %}- {%s goal %}
{% endfor %}<<<END_USER_GOALS>>>

{% endif %}{% endif %}
{% if len(profiles) > 1 %}
<<<PARTNER_WORKOUT>>>
This is a partner workout for {%d len(profiles) %} participants.
Apply MOST RESTRICTIVE constraints - if ANY participant has an injury/limitation, avoid those exercises for ALL participants.
<<<END_PARTNER_WORKOUT>>>

{% endif %}
{% for i, profile := range profiles %}
<<<USER_PROFILE{% if len(profiles) > 1 %} #{%d i+1 %}{% endif %}>>>
Age: {%d profile.Age() %}, Height: {%f.0 profile.Height %}cm, Weight: {%f.0 profile.Weight %}kg, Gender: {%s profile.Gender %}
{% if len(profile.Goals()) > 0 %}Goals: {% for j, goal := range profile.Goals() %}{%s goal.Description %}{% if j < len(profile.Goals())-1 %}, {% endif %}{% endfor %}{% endif %}
{% if len(profile.Injuries()) > 0 %}Injuries (AVOID): {% for j, injury := range profile.Injuries() %}{%s injury.Description %} ({%d injury.Year %}){% if j < len(profile.Injuries())-1 %}, {% endif %}{% endfor %}{% endif %}
{% if len(profile.Limitations()) > 0 %}Limitations: {% for j, limitation := range profile.Limitations() %}{%s limitation %}{% if j < len(profile.Limitations())-1 %}, {% endif %}{% endfor %}{% endif %}
<<<END_USER_PROFILE{% if len(profiles) > 1 %} #{%d i+1 %}{% endif %}>>>

{% endfor %}

{% if len(userPrompt) > 0 %}
<<<USER_REQUEST>>>
{%s userPrompt %}
<<<END_USER_REQUEST>>>
{% endif %}

{% if len(equipment) > 0 %}
<<<EQUIPMENT>>>
{% for i, eq := range equipment %}{%s eq %}{% if i < len(equipment)-1 %}, {% endif %}{% endfor %}
<<<END_EQUIPMENT>>>
{% endif %}

{% if len(modifiers) > 0 %}
<<<EQUIPMENT_MODIFIERS (available to enhance exercises)>>>
{% for _, mod := range modifiers %}- {%s mod.ID %}: applies to exercises matching [{%s strings.Join(mod.Patterns, ", ") %}]
{% endfor %}<<<END_EQUIPMENT_MODIFIERS>>>
{% endif %}

<<<WARMUP_EXERCISES ({%d len(warmupExercises) %} options)>>>
Use ONLY these exercise IDs for the warmup routine.
{% for _, exercise := range warmupExercises %}
- {%s exercise.ID %}{% if len(exercise.Equipment) > 0 %} [{% for i, eq := range exercise.Equipment %}{%s eq %}{% if i < len(exercise.Equipment)-1 %}, {% endif %}{% endfor %}]{% endif %} → {%s strings.Join(exercise.Muscles, ", ") %}{% endfor %}
<<<END_WARMUP_EXERCISES>>>

<<<WORK_EXERCISES ({%d len(workExercises) %} options)>>>
Use ONLY these exercise IDs for the work routine. Select {%d len(workExercises)/4 %}-{%d len(workExercises)/2 %} for a balanced workout.
{% for _, exercise := range workExercises %}
- {%s exercise.ID %}{% if len(exercise.Equipment) > 0 %} [{% for i, eq := range exercise.Equipment %}{%s eq %}{% if i < len(exercise.Equipment)-1 %}, {% endif %}{% endfor %}]{% endif %} → {%s strings.Join(exercise.Muscles, ", ") %}{% endfor %}
<<<END_WORK_EXERCISES>>>

<<<COOLDOWN_EXERCISES ({%d len(cooldownExercises) %} options)>>>
Use ONLY these exercise IDs for the cooldown routine.
{% for _, exercise := range cooldownExercises %}
- {%s exercise.ID %}{% if len(exercise.Equipment) > 0 %} [{% for i, eq := range exercise.Equipment %}{%s eq %}{% if i < len(exercise.Equipment)-1 %}, {% endif %}{% endfor %}]{% endif %} → {%s strings.Join(exercise.Muscles, ", ") %}{% endfor %}
<<<END_COOLDOWN_EXERCISES>>>

{% if len(recentTrainings) > 0 %}
<<<RECENT_HISTORY (CRITICAL: analyze progression towards USER_GOALS, apply progressive overload, respect user feedback)>>>
{% for _, training := range recentTrainings %}{%d training.DaysSince() %}d ago{% if len(training.Feedback) > 0 %} | feedback: {%s training.Feedback %}{% endif %} | exercises: {% for _, activity := range training.Activities() %}{%s activity.Name %} ({% if activity.WeightKg > 0 %}weight: {%d activity.WeightKg %}kg{% endif %}, {% if activity.Reps > 0 %}reps: {%d activity.Reps %}{% endif %}, {% if len(activity.Feedback) > 0 %}feedback: {%s activity.Feedback %}{% endif %}) {% endfor %}
{% endfor %}<<<END_RECENT_HISTORY>>>
{% endif %}

{% if len(recentGenerations) > 0 %}
<<<RECENT_GENERATIONS (avoid repeating names, types and workout rationale — if the user does not ask otherwise)>>>
{% for _, training := range recentGenerations %}{%s training.Name %}
{% endfor %}<<<END_RECENT_GENERATIONS>>>
{% endif %}

{% if len(facts) > 0 %}
<<<KNOWLEDGE_FACTS>>>
{% for _, fact := range facts %}[{%s fact.Reference %}] {%s fact.Content %}
{% endfor %}<<<END_KNOWLEDGE_FACTS>>>
{% endif %}

{% if len(classics) > 0 %}
<<<NAMING_INSPIRATION>>>
{% for _, classic := range classics %}{%s classic.Excerpt %}
{% endfor %}<<<END_NAMING_INSPIRATION>>>
{% endif %}

Output language: {% if len(profiles) > 0 && len(profiles[0].Language) > 0 %}{%s profiles[0].Language %}{% else %}English{% endif %}
{% endfunc %}
