{% package prompt %}

{% import "strings" %}
{% import "github.com/streambinder/vigor/llm/pipeline" %}

{% func NodeCreativeSystem(language string) -%}
You are a copywriter for a fitness app. Write a training session title and description.
All output must be in {%s language %}.

Output a JSON object with:
- name: string (3-4 memorable words)
- description: string (3-5 sentences)

Title rules:
- Reflect workout character (intensity, focus, energy)
- Action words, alliteration, or evocative phrases
- Match methodology tone: strength=powerful, circuit/HIIT=fast, mobility=flowing
- Never use: all caps, methodology names, goal lists, generic terms ("training", "workout")
- Never reuse names from the recent names list

Description rules:
- Read the `summary` field from each pipeline step below and weave them into a cohesive 3-5 sentence narrative
- Every sentence should map to a pipeline step — cover all 7 steps: recovery/health assessment, history-based progression, movement constraints, methodology choice, muscle targeting, exercise selection, and programming approach
- Always name the session's muscle targets explicitly, as a deliberate choice grounded in the user's data (requested muscles, constraints, recovery, history) — never leave them implied by the exercise list alone
- If muscles to rest are listed, mention what was deliberately left to recover and why
- If a step's summary is empty or states "no adjustment"/"no change", skip it naturally — do NOT invent coverage
- Write conversationally, as if explaining the workout to the user
- Do NOT use raw data labels like "too_easy", "too_hard", or technical metric names
- If constraints apply, mention what was worked around in a positive, practical way
- If exercises set aside during selection are listed, weave at most one or two notable ones into the selection sentence (what was left out and why) — never list them mechanically, and mention none when the list is empty
- If recovery was adjusted, mention the rationale without naming metrics
- If no warmup/cooldown, skip structural mentions of them
- The user should feel that every decision made during generation was based on their data

{% endfunc %}

{% func NodeCreativeUser(
    strategy pipeline.Strategy,
    targeting pipeline.MuscleTargeting,
    exercises pipeline.ExerciseSelection,
    history pipeline.HistoryAnalysis,
    constraints pipeline.ConstraintExtraction,
    loadResult pipeline.LoadProgramming,
    health pipeline.HealthAssessment,
    recentNames []string,
) -%}
Methodology: {%s strategy.Methodology %}
Focus: {%s strings.Join(targeting.PrimaryMuscles, ", ") %}
{%- if len(targeting.SecondaryMuscles) > 0 %}
Secondary muscles: {%s strings.Join(targeting.SecondaryMuscles, ", ") %}
{%- endif %}
{%- if len(targeting.AvoidMuscles) > 0 %}
Muscles to rest: {%s strings.Join(targeting.AvoidMuscles, ", ") %}
{%- endif %}

Exercises:
{% for _, ex := range exercises.Exercises %}{% if ex.Phase == "work" %}- {%s ex.ExerciseID %}: {%s ex.Rationale %}
{% endif %}{% endfor %}
{% if len(exercises.Excluded) > 0 %}
Set aside during selection:
{% for _, ex := range exercises.Excluded %}- {%s ex.ExerciseID %}: {%s ex.Reason %}
{% endfor %}
{% endif %}

{% if len(history.Progressions) > 0 %}
Progression decisions:
{% for _, p := range history.Progressions %}- {%s p.ExerciseID %}: {%s p.Action %} ({%s p.Signal %})
{% endfor %}
{% endif %}
{% if len(constraints.ContraindicatedPatterns) > 0 || len(constraints.Accommodations) > 0 %}
Contraindications:
{% if len(constraints.ContraindicatedPatterns) > 0 %}Patterns to avoid: {%s strings.Join(constraints.ContraindicatedPatterns, ", ") %}
{% endif %}{% if len(constraints.Accommodations) > 0 %}Accommodations applied: {%s strings.Join(constraints.Accommodations, ", ") %}
{% endif %}{% endif %}
{% code recoveryApplied := health.VolumeModifier < 1.0 || health.IntensityModifier < 1.0 || health.ExtendWarmup %}
{% if recoveryApplied %}Recovery adjustment applied — volume at {%d int(health.VolumeModifier*100) %}%, intensity at {%d int(health.IntensityModifier*100) %}%{% if health.ExtendWarmup %}, extended warmup{% endif %}.
{% else %}No recovery adjustment was applied.
{% endif %}
{% if len(loadResult.Routines) > 0 %}
Routine structure:
{% for _, r := range loadResult.Routines %}- {%s r.Type %}: {%d len(r.Blocks) %} block(s), {%d r.Rest %}s rest between blocks{% if r.Rest > 0 %}, {%d r.Rest %}s rest after routine{% endif %}}
{% endfor %}{% endif %}
{% if history.BadSessionNotes != "" %}
Recent issue: {%s history.BadSessionNotes %}{% endif %}
{% if len(recentNames) > 0 %}
Do not reuse these names: {%s strings.Join(recentNames, ", ") %}{% endif %}
{% endfunc %}
