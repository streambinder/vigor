{% package rag %}

{% import "github.com/streambinder/vigor/model" %}

{% func GenUserFacts(profile model.Profile, prompt string) -%}
{% collapsespace %}

Knowledge for:
{% if len(prompt) > 0 %}Request: {%s prompt %}.{% endif %}
{% if len(profile.Goals()) > 0 %}Goals: {% for i, goal := range profile.Goals() %}{%s goal.Description %}{% if i < len(profile.Goals())-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(profile.Injuries()) > 0 %}Injuries: {% for i, injury := range profile.Injuries() %}{%s injury.Description %}{% if i < len(profile.Injuries())-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(profile.Limitations()) > 0 %}Limitations: {% for i, limitation := range profile.Limitations() %}{%s limitation %}{% if i < len(profile.Limitations())-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(prompt) == 0 && len(profile.Goals()) == 0 && len(profile.Injuries()) == 0 && len(profile.Limitations()) == 0 %}General fitness knowledge.{% endif %}

{% endcollapsespace -%}
{% endfunc %}
