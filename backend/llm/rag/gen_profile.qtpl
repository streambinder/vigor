{% package rag %}

{% import "github.com/streambinder/vigor/model" %}
{% import "github.com/streambinder/vigor/util" %}

{% func GenProfile(profiles []model.Profile, goals, equipment, muscles []string, prompt string) -%}
{% collapsespace %}

{% code

var (
	injuries    []string
	limitations []string
	conditions  []string
)
for _, profile := range profiles {
	limitations = append(limitations, profile.Limitations()...)
	conditions = append(conditions, profile.Conditions()...)
	for _, injury := range profile.Injuries() {
		injuries = append(injuries, injury.Description)
	}
}
if len(goals) == 0 {
	for _, profile := range profiles {
		for _, goal := range profile.Goals() {
			goals = append(goals, goal)
		}
	}
}

injuries = util.Dedupe(injuries)
limitations = util.Dedupe(limitations)
conditions = util.Dedupe(conditions)
goals = util.Dedupe(goals)

%}

{% if len(prompt) > 0 %}Request: {%s prompt %}.{% endif %}
{% if len(goals) > 0 %}Goals: {% for i, goal := range goals %}{%s goal %}{% if i < len(goals)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(injuries) > 0 %}Injuries: {% for i, injury := range injuries %}{%s injury %}{% if i < len(injuries)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(limitations) > 0 %}Limitations: {% for i, limitation := range limitations %}{%s limitation %}{% if i < len(limitations)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(conditions) > 0 %}Conditions: {% for i, condition := range conditions %}{%s condition %}{% if i < len(conditions)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(equipment) > 0 %}Equipment: {% for i, eq := range equipment %}{%s eq %}{% if i < len(equipment)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(muscles) > 0 %}Muscles: {% for i, eq := range muscles %}{%s eq %}{% if i < len(muscles)-1 %}, {% endif %}{% endfor %}.{% endif %}

{% endcollapsespace -%}
{% endfunc %}
