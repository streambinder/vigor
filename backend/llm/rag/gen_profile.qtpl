{% package rag %}

{% import "github.com/streambinder/vigor/model" %}

{% code
type ProfilePurpose int

const (
	ProfilePurposeFacts ProfilePurpose = iota
	ProfilePurposeExercises
)
%}

{% func GenProfile(profiles []model.Profile, goals []string, equipment []string, prompt string, purpose ProfilePurpose) -%}
{% collapsespace %}

{% if purpose == ProfilePurposeFacts %}Knowledge for:{% else %}Exercises for:{% endif %}
{% code
	var allGoals, allInjuries, allLimitations, allConditions []string
	goalSet := make(map[string]bool)
	injurySet := make(map[string]bool)
	limitationSet := make(map[string]bool)
	conditionSet := make(map[string]bool)
	for _, goal := range goals {
		if !goalSet[goal] {
			goalSet[goal] = true
			allGoals = append(allGoals, goal)
		}
	}
	for _, profile := range profiles {
		for _, injury := range profile.Injuries() {
			if !injurySet[injury.Description] {
				injurySet[injury.Description] = true
				allInjuries = append(allInjuries, injury.Description)
			}
		}
		for _, limitation := range profile.Limitations() {
			if !limitationSet[limitation] {
				limitationSet[limitation] = true
				allLimitations = append(allLimitations, limitation)
			}
		}
		for _, condition := range profile.Conditions() {
			if !conditionSet[condition] {
				conditionSet[condition] = true
				allConditions = append(allConditions, condition)
			}
		}
	}
%}
{% if len(prompt) > 0 %}Request: {%s prompt %}.{% endif %}
{% if len(allGoals) > 0 %}Goals: {% for i, goal := range allGoals %}{%s goal %}{% if i < len(allGoals)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(allInjuries) > 0 %}{% if purpose == ProfilePurposeFacts %}Injuries{% else %}Avoid{% endif %}: {% for i, injury := range allInjuries %}{%s injury %}{% if i < len(allInjuries)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(allLimitations) > 0 %}Limitations: {% for i, limitation := range allLimitations %}{%s limitation %}{% if i < len(allLimitations)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(allConditions) > 0 %}Conditions: {% for i, condition := range allConditions %}{%s condition %}{% if i < len(allConditions)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if purpose == ProfilePurposeExercises && len(equipment) > 0 %}Equipment: {% for i, eq := range equipment %}{%s eq %}{% if i < len(equipment)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% code
	hasContent := len(prompt) > 0 || len(allGoals) > 0 || len(allInjuries) > 0 || len(allLimitations) > 0 || len(allConditions) > 0
	if purpose == ProfilePurposeExercises {
		hasContent = hasContent || len(equipment) > 0
	}
%}
{% if !hasContent %}{% if purpose == ProfilePurposeFacts %}General fitness knowledge.{% else %}General fitness exercises.{% endif %}{% endif %}

{% endcollapsespace -%}
{% endfunc %}
