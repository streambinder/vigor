{% package rag %}

{% import "strings" %}
{% import "github.com/streambinder/vigor/model" %}

{% func GenFact(fact model.Fact) -%}
{% collapsespace %}

{%s fact.Area %}: {%s fact.Content %}
{% if len(fact.Tags) > 0 %}Tags: {%s strings.Join(fact.Tags, ", ") %}.{% endif %}

{% endcollapsespace -%}
{% endfunc %}
