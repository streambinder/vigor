{% package rag %}

{% import "github.com/streambinder/vigor/model" %}

{% func GenUserExercises(profile model.Profile, equipment []string) -%}
{% collapsespace %}

Exercises for:
{% if len(profile.Goals()) > 0 %}Goals: {% for i, goal := range profile.Goals() %}{%s goal.Description %}{% if i < len(profile.Goals())-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(profile.Injuries()) > 0 %}Avoid: {% for i, injury := range profile.Injuries() %}{%s injury.Description %}{% if i < len(profile.Injuries())-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(profile.Limitations()) > 0 %}Limitations: {% for i, limitation := range profile.Limitations() %}{%s limitation %}{% if i < len(profile.Limitations())-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(equipment) > 0 %}Equipment: {% for i, eq := range equipment %}{%s eq %}{% if i < len(equipment)-1 %}, {% endif %}{% endfor %}.{% endif %}
{% if len(profile.Goals()) == 0 && len(profile.Injuries()) == 0 && len(profile.Limitations()) == 0 && len(equipment) == 0 %}General fitness exercises.{% endif %}

{% endcollapsespace -%}
{% endfunc %}
